<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- =========================================================== -->
    <!-- BLUETOOTH PERMISSIONS                                        -->
    <!-- =========================================================== -->
    <!-- Legacy (< Android 12 / API 31) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12+ (API 31+) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- =========================================================== -->
    <!-- LOCATION (needed for BLE scan on Android 10–11)              -->
    <!-- =========================================================== -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- =========================================================== -->
    <!-- NETWORK (weather lookup)                                     -->
    <!-- =========================================================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- =========================================================== -->
    <!-- CALLS & CONTACTS                                             -->
    <!-- =========================================================== -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- =========================================================== -->
    <!-- FOREGROUND SERVICE (keeps NotificationListener alive)        -->
    <!-- =========================================================== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:targetApi="q" />

    <!-- Notifications on Android 13+ -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="tiramisu" />

    <!-- =========================================================== -->
    <!-- PACKAGE VISIBILITY (Android 11+)                             -->
    <!-- =========================================================== -->
    <!-- Required to list ALL installed apps in the notification filter.
         Play Store requires justification for this permission; our
         use case is documented in the app's Play Console listing:
         "SmartDrive is a companion app for an ESP32 navigation device;
          users select which apps may forward notifications over BLE." -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Explicit list so common apps still appear if QUERY_ALL_PACKAGES
         is ever removed (e.g., Play Store policy change). -->
    <queries>
        <!-- Allow enumerating launcher apps (fallback for the filter list) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- Messaging -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.android.mms" />

        <!-- Social -->
        <package android:name="com.snapchat.android" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.discord" />
        <package android:name="com.twitter.android" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.linkedin.android" />

        <!-- Email -->
        <package android:name="com.google.android.gm" />
        <package android:name="com.microsoft.office.outlook" />

        <!-- Work / video -->
        <package android:name="com.microsoft.teams" />
        <package android:name="com.microsoft.office.officehubrow" />
        <package android:name="com.skype.raider" />

        <!-- Music (for media keys) -->
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />

        <!-- Navigation -->
        <package android:name="com.google.android.apps.maps" />
        <package android:name="net.osmand" />
        <package android:name="net.osmand.plus" />
    </queries>

    <!-- =========================================================== -->
    <!-- FEATURES                                                     -->
    <!-- =========================================================== -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- =========================================================== -->
    <!-- APPLICATION                                                  -->
    <!-- =========================================================== -->
    <application
        android:name=".SmartDriveApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartDrive"
        tools:targetApi="31">

        <!-- Main launcher activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartDrive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification listener — bound by the system when the user
             grants Notification Access in Settings. -->
        <service
            android:name=".presentation.notification.NotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Foreground service that keeps the process alive so the
             NotificationListener keeps working when the app is in the
             background. Started from NotificationListener.onCreate(). -->
        <service
            android:name=".presentation.notification.ListenerKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>