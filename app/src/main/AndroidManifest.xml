<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Location (BLE scan on < API 31) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Network (weather) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Calls -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Foreground service for notification listener -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required on Android 11+ to list all installed apps for the
         notification filter. Play Store requires justification; our
         purpose is: "SmartDrive lets users choose which apps can post
         notifications to a paired ESP32 device." -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Explicit list so common apps still appear even if the
         Play Store review flags QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- The apps you asked for -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.instagram.android" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.microsoft.teams" />
        <package android:name="com.microsoft.office.outlook" />
        <package android:name="com.microsoft.office.officehubrow" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.android.mms" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.skype.raider" />
        <package android:name="com.discord" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.twitter.android" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="net.osmand" />
        <package android:name="net.osmand.plus" />
    </queries>

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:name=".SmartDriveApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SmartDrive"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartDrive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification listener service (bound by system) -->
        <service
            android:name=".presentation.notification.NotificationListener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Foreground service to keep the listener alive -->
        <service
            android:name=".presentation.notification.ListenerKeepAliveService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>